{
  "name": "@ngnestpostgres/luv-coffee-be",
  "version": "0.0.33",
  "repository": "https://github.com/NgNestPostgres/luv-coffee-be.git",
  "author": "Andriy<veldymanov@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "22.x.x"
  },
  "scripts": {
    "serve": "nest start --debug 0.0.0.0:9229 --watch --tsc",
    "compose:local": "docker compose --env-file=.env/.env.local up",
    "compose:local:update": "docker compose --env-file=.env/.env.local up --build -V",
    "serve:dev": "cross-env NODE_ENV=local-server-dev-db nest start --debug 0.0.0.0:9229 --watch --tsc",
    "compose:local:db": "docker compose --env-file=.env/.env.local up postgres",
    "docker:build:local:image": "docker image build -t luv-coffee-prod --progress=plain --no-cache --target prod .",
    "docker:run:local:image": "docker run --rm --env-file=.env/.env.local-build -p 8080:8080 luv-coffee-prod",
    "build": "nest build --tsc",
    "build:luv-coffee-be": "nest build luv-coffee-be --tsc",
    "build:fe-shared": "nest build fe-shared --tsc",
    "build:fe-shared:watch": "nest build fe-shared --watch --tsc",
    "copy:packagefiles": "cp libs/fe-shared/package.json libs/fe-shared/README.md packages/fe-shared",
    "publish:fe-shared": "npm run build:fe-shared && npm run copy:packagefiles && npm publish ./packages/fe-shared",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:file": "jest src/coffees/coffees.service.spec.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "docker:run:ci": "docker image build -t luv-coffee-ci --progress=plain --no-cache --target ci .",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:docker": "yarn copy:yarn.lock && docker compose -f docker-compose.e2e.yml --env-file=.env/.env.e2e up --abort-on-container-exit --exit-code-from app_e2e",
    "test:e2e:docker:update": "yarn copy:yarn.lock && docker compose -f docker-compose.e2e.yml up --build -V --abort-on-container-exit --exit-code-from app_e2e",
    "typeorm:create-migration": "npx typeorm migration:create src/db/migrations/CoffeeRefactor",
    "typeorm:generate-migration": "npm run build && npx typeorm migration:generate src/db/migrations/SchemaSync -d dist/typeorm.config",
    "typeorm:migrate:local": "npm run build && npx typeorm migration:run -d dist/typeorm.config",
    "typeorm:migration:revert:local": "npx typeorm migration:revert -d dist/typeorm.config",
    "typeorm:migration:status:local": "npx typeorm migration:show -d dist/typeorm.config",
    "db:proxy": "./cloud-sql-proxy --port 3307 luv-coffee-414618:europe-west1:luv-coffee-dev-1",
    "db:migrate:dev": "cross-env NODE_ENV=dev yarn typeorm:cli migration:run",
    "db:migration:revert:dev": "cross-env NODE_ENV=dev yarn typeorm:cli migration:revert",
    "db:migration:status:dev": "cross-env NODE_ENV=dev yarn typeorm:cli migration:show",
    "deploy:dev": "gcloud app deploy app.dev.yaml --project luv-coffee-414618",
    "gcp-build": "yarn build",
    "security:sync-dot-env": "rm -r .env && mkdir .env && gsutil rsync -u -r -d -C gs://luv-coffee-dot-env .env/",
    "copy:yarn.lock": "cp ../../../yarn.lock ./",
    "delete:yarn.lock": "rm -f yarn.lock",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "husky": "^9.1.7",
    "joi": "^17.13.3",
    "luxon": "^3.5.0",
    "nodemailer": "^6.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.21",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.11",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/hapi__joi": "^17.1.15",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "jest-mock": "^29.7.0",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "modulePaths": [
      "<rootDir>"
    ],
    "moduleNameMapper": {
      "@auth/(.*)": "<rootDir>/src/auth/$1",
      "@common/(.*)": "<rootDir>/src/common/$1",
      "@email/(.*)": "<rootDir>/src/email/$1",
      "@modules/(.*)": "<rootDir>/src/modules/$1",
      "@users/(.*)": "<rootDir>/src/users/$1",
      "^@lib/fe-shared(|/.*)$": "<rootDir>/libs/fe-shared/src/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/libs/"
    ]
  }
}
